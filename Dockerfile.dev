# syntax=docker/dockerfile:1
#
# Dev image: builds a proximo stack binary (dnsserver / watcher) from the local
# source tree. Used only when PROXIMO_SRC is set, so local changes can be tested
# without publishing the module. Production builds use dns.Dockerfile /
# watcher.Dockerfile (go install <module>@<ref>).
ARG GO_VERSION=1.26
ARG CMD
ARG PROXIMO_REF

FROM golang:${GO_VERSION}-alpine AS build
ARG CMD
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/app ./cmd/${CMD}

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /out/app /usr/local/bin/app
ENTRYPOINT ["/usr/local/bin/app"]
